<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="AirspyPanel · Live Aero" Width="1180" Height="820"
 Background="{DynamicResource BrushEAF4FA}" Foreground="{DynamicResource Brush284A62}" FontFamily="Microsoft YaHei UI"
 FontSize="12" WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
 SnapsToDevicePixels="True" ToolTipService.InitialShowDelay="450" ToolTipService.ShowDuration="30000">
 <Window.Resources>
  <LinearGradientBrush x:Key="Glass" StartPoint="0,0" EndPoint="0,1">
   <GradientStop Color="{DynamicResource ColorFFFFFF}" Offset="0"/><GradientStop Color="{DynamicResource ColorEDF7FC}" Offset=".46"/>
   <GradientStop Color="{DynamicResource ColorD5EAF5}" Offset=".47"/><GradientStop Color="{DynamicResource ColorF2FAFF}" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="PanelSurface" StartPoint="0,0" EndPoint="0,1">
   <GradientStop Color="{DynamicResource ColorFFFFFF}" Offset="0"/><GradientStop Color="{DynamicResource ColorF1F7FB}" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="GreenButton" StartPoint="0,0" EndPoint="0,1">
   <GradientStop Color="{DynamicResource ColorF5FFE8}" Offset="0"/><GradientStop Color="{DynamicResource ColorD6EDAC}" Offset=".48"/>
   <GradientStop Color="{DynamicResource ColorB9DA83}" Offset=".49"/><GradientStop Color="{DynamicResource ColorE1F4BB}" Offset="1"/>
  </LinearGradientBrush>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style x:Key="Muted" TargetType="TextBlock">
   <Setter Property="Foreground" Value="{DynamicResource Brush526F83}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="{DynamicResource Brush234B67}"/><Setter Property="Background" Value="{DynamicResource Glass}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource Brush94B3C7}"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="12,7"/><Setter Property="MinHeight" Value="32"/>
   <Setter Property="Margin" Value="0,3"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Body" CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
     <Border CornerRadius="3" BorderBrush="{DynamicResource BrushCCFFFFFF}" BorderThickness="1" Padding="{TemplateBinding Padding}">
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
     </Border>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource Brush3297D2}"/><Setter TargetName="Body" Property="Background" Value="{DynamicResource BrushE6F6FF}"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Body" Property="Background" Value="{DynamicResource BrushC2DFEE}"/><Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource Brush427F9F}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource Brush0879BD}"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Body" Property="Opacity" Value=".5"/><Setter Property="Foreground" Value="{DynamicResource Brush647681}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Background" Value="{DynamicResource BrushFFFFFF}"/><Setter Property="Foreground" Value="{DynamicResource Brush253E50}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource BrushA0B9CA}"/><Setter Property="Padding" Value="7,5"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="MinHeight" Value="30"/>
   <Style.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Brush2489C0}"/></Trigger></Style.Triggers>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Foreground" Value="{DynamicResource Brush253E50}"/><Setter Property="Background" Value="{DynamicResource BrushF1F7FB}"/><Setter Property="Padding" Value="7,5"/><Setter Property="MinHeight" Value="30"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
    <Grid>
     <ToggleButton x:Name="DropButton" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Focusable="False">
      <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="DropBorder" Background="{DynamicResource Glass}" BorderBrush="{DynamicResource BrushA0B9CA}" BorderThickness="1" CornerRadius="3"><Path Data="M 0,0 L 8,0 L 4,4 Z" Fill="{DynamicResource Brush526F83}" Width="8" Height="4" Stretch="Fill" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="DropBorder" Property="BorderBrush" Value="{DynamicResource Brush2489C0}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
     </ToggleButton>
     <ContentPresenter Margin="8,4,27,4" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" VerticalAlignment="Center" IsHitTestVisible="False"/>
     <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
      <Border Background="{DynamicResource BrushFFFFFF}" BorderBrush="{DynamicResource BrushA0B9CA}" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="240">
       <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
      </Border>
     </Popup>
    </Grid>
    <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".5"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="DropButton" Property="Opacity" Value=".85"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="CheckBox">
   <Setter Property="Foreground" Value="{DynamicResource Brush3D5B70}"/><Setter Property="Margin" Value="0,8"/><Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
    <StackPanel Orientation="Horizontal" Background="Transparent">
     <Border x:Name="Box" Width="16" Height="16" CornerRadius="2" BorderThickness="1" BorderBrush="{DynamicResource BrushA0B9CA}" Background="{DynamicResource BrushFFFFFF}" VerticalAlignment="Center">
      <TextBlock x:Name="Tick" Visibility="Collapsed" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource Brush32842C}" HorizontalAlignment="Center"/>
     </Border><ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
    </StackPanel>
    <ControlTemplate.Triggers>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush2489C0}"/></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush2489C0}"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".5"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TabItem">
   <Setter Property="Foreground" Value="{DynamicResource Brush496C85}"/><Setter Property="Padding" Value="15,8"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
    <Border x:Name="Tab" Background="{DynamicResource Glass}" BorderBrush="{DynamicResource BrushA6C1D2}" BorderThickness="1" CornerRadius="4,4,0,0" Margin="0,0,3,0" Padding="{TemplateBinding Padding}">
     <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="Tab" Property="Background" Value="{DynamicResource BrushFFFFFF}"/><Setter TargetName="Tab" Property="BorderThickness" Value="1,1,1,0"/><Setter Property="Foreground" Value="{DynamicResource Brush17689A}"/></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tab" Property="BorderBrush" Value="{DynamicResource Brush4098C6}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Tab" Property="BorderBrush" Value="{DynamicResource Brush0879BD}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="DataGridColumnHeader">
   <Setter Property="Background" Value="{DynamicResource Glass}"/><Setter Property="Foreground" Value="{DynamicResource Brush45677E}"/>
   <Setter Property="Padding" Value="9,8"/><Setter Property="BorderBrush" Value="{DynamicResource BrushCDDEE9}"/><Setter Property="BorderThickness" Value="0,0,1,1"/><Setter Property="FontWeight" Value="Normal"/>
  </Style>
  <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="8,6"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
   <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource Brush143F5C}"/><Setter Property="Background" Value="{DynamicResource BrushD5EBFA}"/></Trigger></Style.Triggers>
  </Style>
  <Style TargetType="DataGridRow"><Setter Property="Foreground" Value="{DynamicResource Brush294A60}"/><Setter Property="MinHeight" Value="34"/>
   <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource BrushD5EBFA}"/></Trigger></Style.Triggers>
  </Style>
  <Style TargetType="ProgressBar">
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar">
    <Border BorderBrush="{DynamicResource Brush7C9B91}" BorderThickness="1" CornerRadius="3" Background="{DynamicResource BrushE3EDE7}" Padding="2">
     <Grid x:Name="PART_Track" ClipToBounds="True">
      <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="1">
       <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="{DynamicResource ColorC7F69B}" Offset="0"/><GradientStop Color="{DynamicResource Color8ECE55}" Offset=".46"/><GradientStop Color="{DynamicResource Color57AA29}" Offset=".5"/><GradientStop Color="{DynamicResource Color91D158}" Offset="1"/></LinearGradientBrush></Border.Background>
      </Border>
      <Rectangle IsHitTestVisible="False"><Rectangle.Fill>
       <DrawingBrush TileMode="Tile" Viewport="0,0,9,20" ViewportUnits="Absolute" Viewbox="0,0,9,20" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing><GeometryDrawing Brush="{DynamicResource BrushCFFFFFFF}" Geometry="M 8,0 L 9,0 9,20 8,20 Z"/></DrawingBrush.Drawing>
       </DrawingBrush>
      </Rectangle.Fill></Rectangle>
     </Grid>
    </Border>
   </ControlTemplate></Setter.Value></Setter>
  </Style>

  <Style TargetType="ToolTip">
   <Setter Property="Background" Value="{DynamicResource BrushF1F7FB}"/><Setter Property="Foreground" Value="{DynamicResource Brush253E50}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource BrushA0B9CA}"/><Setter Property="Padding" Value="12"/><Setter Property="MaxWidth" Value="330"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ScrollThumb" TargetType="Thumb">
   <Setter Property="MinHeight" Value="18"/><Setter Property="MinWidth" Value="18"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb">
    <Border x:Name="Grip" Background="{DynamicResource BrushA0B9CA}" CornerRadius="4" Margin="2"/>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="{DynamicResource Brush4098C6}"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="Grip" Property="Background" Value="{DynamicResource Brush2489C0}"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ScrollPage" TargetType="RepeatButton"><Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ScrollBar">
   <Setter Property="Width" Value="12"/><Setter Property="Background" Value="{DynamicResource BrushEDF7FC}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
    <Border Background="{TemplateBinding Background}" CornerRadius="5">
     <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
      <Track.DecreaseRepeatButton><RepeatButton x:Name="Decrease" Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollPage}"/></Track.DecreaseRepeatButton>
      <Track.Thumb><Thumb x:Name="ScrollGrip" Style="{StaticResource ScrollThumb}"/></Track.Thumb>
      <Track.IncreaseRepeatButton><RepeatButton x:Name="Increase" Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollPage}"/></Track.IncreaseRepeatButton>
     </Track>
    </Border>
    <ControlTemplate.Triggers><Trigger Property="Orientation" Value="Horizontal">
     <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/><Setter TargetName="ScrollGrip" Property="MinHeight" Value="0"/>
     <Setter TargetName="Decrease" Property="Command" Value="ScrollBar.PageLeftCommand"/>
     <Setter TargetName="Increase" Property="Command" Value="ScrollBar.PageRightCommand"/>
    </Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
   <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Height" Value="12"/><Setter Property="Width" Value="Auto"/></Trigger></Style.Triggers>
  </Style>
  <Style TargetType="ComboBoxItem">
   <Setter Property="Foreground" Value="{DynamicResource Brush253E50}"/><Setter Property="Padding" Value="7,6"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
    <Border x:Name="Item" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="{DynamicResource BrushD5EBFA}"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Expander">
   <Setter Property="Foreground" Value="{DynamicResource Brush284A62}"/><Setter Property="Margin" Value="0,5"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
    <StackPanel>
     <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Foreground="{TemplateBinding Foreground}" HorizontalContentAlignment="Left">
      <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
       <Border x:Name="Head" Padding="3,7" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" CornerRadius="3">
        <DockPanel><TextBlock x:Name="Chevron" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="10" Margin="0,0,8,0" RenderTransformOrigin=".5,.5"/><ContentPresenter/></DockPanel>
       </Border>
       <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Head" Property="Background" Value="{DynamicResource BrushEDF7FC}"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Head" Property="BorderBrush" Value="{DynamicResource Brush2489C0}"/></Trigger>
        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter></Trigger>
       </ControlTemplate.Triggers>
      </ControlTemplate></ToggleButton.Template>
      <ContentPresenter ContentSource="Header"/>
     </ToggleButton>
     <ContentPresenter x:Name="Expanded" Visibility="Collapsed"/>
    </StackPanel>
    <ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="Expanded" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid x:Name="RootLayout" Margin="14,10,14,10" Background="{DynamicResource BrushEAF4FA}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border x:Name="FullHeader" Grid.Row="0" CornerRadius="7" BorderBrush="{DynamicResource Brush9BBED3}" BorderThickness="1" Margin="0,0,0,10">
   <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="{DynamicResource ColorF9FDFF}" Offset="0"/><GradientStop Color="{DynamicResource ColorD5ECFA}" Offset=".5"/>
    <GradientStop Color="{DynamicResource ColorBDDDF1}" Offset=".51"/><GradientStop Color="{DynamicResource ColorE6F5FD}" Offset="1"/>
   </LinearGradientBrush></Border.Background>
   <Grid x:Name="HeaderGrid" Margin="12,8">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Image x:Name="BrandIcon" Source="{DynamicResource AirplaneIcon}" Width="44" Height="44" Margin="0,0,12,0"/>
    <StackPanel x:Name="BrandText" Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="BrandTitle" Text="AirspyPanel" FontFamily="Segoe UI" FontSize="28" FontWeight="Light" Foreground="{DynamicResource Brush215A80}"/><TextBlock x:Name="Tagline" Text="{DynamicResource Loc_s209}" FontSize="11" Foreground="{DynamicResource Brush527E99}"/></StackPanel>
    <Grid x:Name="HeaderTools" Grid.Column="2" VerticalAlignment="Center" Height="32">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="6"/><ColumnDefinition x:Name="ThemeColumn" Width="104"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Button x:Name="ToggleMode" Content="{DynamicResource Loc_s191}" Padding="8,3" Height="32" Margin="0"/>
     <ComboBox x:Name="ThemeChoice" Grid.Column="2" Height="32" VerticalAlignment="Center" ToolTip="{DynamicResource Loc_s096}" AutomationProperties.Name="{DynamicResource Loc_s096}"/>
     <Border x:Name="HeaderStatus" Grid.Column="4" Height="32" CornerRadius="15" BorderBrush="{DynamicResource BrushA7C4D5}" BorderThickness="1" Background="{DynamicResource Glass}" Padding="7,0">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
       <Ellipse x:Name="ReceptionLamp" Width="8" Height="8" Margin="0,0,5,0" Fill="{DynamicResource Brush8598A4}"/>
       <TextBlock x:Name="RunState" Text="{DynamicResource Loc_s115}" FontSize="11" TextWrapping="NoWrap"/>
      </StackPanel>
     </Border>
    </Grid>
    <TextBlock x:Name="FrequencyCaption" Grid.Row="1" Grid.Column="2" Text="1090 MHz · Airspy / VRS" HorizontalAlignment="Right" FontSize="10" Foreground="{DynamicResource Brush537F98}"/>
   </Grid>
  </Border>
  <Grid x:Name="FullView" Grid.Row="2">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,8">
    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><Button x:Name="TopSettings" Content="{DynamicResource Loc_s212}" Padding="10,4" Margin="0,0,6,0"/></StackPanel>
    <Button x:Name="TopVrsDetails" HorizontalAlignment="Right" Padding="9,4" Margin="0" ToolTip="{DynamicResource Loc_s041}"><StackPanel Orientation="Horizontal"><Ellipse Fill="{Binding Fill, ElementName=VrsLamp}" Width="8" Height="8" Margin="0,0,6,0"/><TextBlock Text="{Binding Text, ElementName=VrsState}"/></StackPanel></Button>
   </DockPanel>
   <Grid x:Name="DashboardGrid" Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="270"/><ColumnDefinition x:Name="SidebarGap" Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border x:Name="MapSidebar" Background="{DynamicResource PanelSurface}" BorderBrush="{DynamicResource BrushACC6D7}" BorderThickness="1" CornerRadius="5">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12">
     <StackPanel>
      <TextBlock Text="{DynamicResource Loc_s134}" FontSize="14" Foreground="{DynamicResource Brush286B95}" FontWeight="SemiBold" Margin="0,0,0,12"/>
      <Button x:Name="OpenSettings" Content="{DynamicResource Loc_s130}"/>
      <TextBlock x:Name="SettingsHint" Text="{DynamicResource Loc_s128}" Style="{StaticResource Muted}" Margin="0,0,0,8"/>
      <TextBlock Text="{DynamicResource Loc_s021}" Style="{StaticResource Muted}" FontSize="11" Margin="0,8,0,14"/>
      <Border Height="1" Background="{DynamicResource BrushD1E2EC}" Margin="0,0,0,14"/>
      <TextBlock Text="{DynamicResource Loc_s086}" FontSize="14" Foreground="{DynamicResource Brush286B95}" FontWeight="SemiBold" Margin="0,0,0,8"/>
      <Button x:Name="VrsDetails" Padding="9,5" Margin="0,0,0,8" ToolTip="{DynamicResource Loc_s170}">
       <StackPanel Orientation="Horizontal"><Ellipse x:Name="VrsLamp" Width="9" Height="9" Fill="{DynamicResource Brush8598A4}" Margin="0,0,7,0"/><TextBlock x:Name="VrsState" Text="{DynamicResource Loc_s040}"/></StackPanel>
      </Button>
      <TextBlock x:Name="VrsHint" Text="{DynamicResource Loc_s189}" Style="{StaticResource Muted}" FontSize="11" Margin="0,8,0,12"/>

     </StackPanel>
    </ScrollViewer>
   </Border>
   <Grid x:Name="ReceiverDashboard" Grid.Column="2">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Background="{DynamicResource Glass}" BorderBrush="{DynamicResource BrushAEC8D9}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,9" Padding="7,3">
     <DockPanel>
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
       <Button x:Name="Start" Content="{DynamicResource Loc_s114}" Background="{DynamicResource GreenButton}" Foreground="{DynamicResource Brush315925}" BorderBrush="{DynamicResource Brush8AAA69}" MinWidth="100" Margin="0,0,7,0"/>
       <Button x:Name="LinkVrs" Content="{DynamicResource Loc_s241}" ToolTip="{DynamicResource Loc_s093}" Background="{DynamicResource GreenButton}" Foreground="{DynamicResource Brush315925}" Margin="0,0,7,0"/>
       <Button x:Name="Stop" Content="{DynamicResource Loc_s062}" ToolTip="{DynamicResource Loc_s061}" MinWidth="84" IsEnabled="False" Margin="0"/>
      </StackPanel>
      <StackPanel x:Name="QuickActions" Orientation="Horizontal" HorizontalAlignment="Right">
       <Button x:Name="QuickMap" Content="{DynamicResource Loc_s118}" Padding="8,5" Margin="6,0,0,0"/>
       <Ellipse Fill="{Binding Fill, ElementName=VrsLamp}" Width="9" Height="9" Margin="8,0,0,0" ToolTip="{Binding Text, ElementName=VrsState}"/>
      </StackPanel>
     </DockPanel>
    </Border>
    <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,12">
     <Border Background="{DynamicResource PanelSurface}" BorderBrush="{DynamicResource BrushB4CCDC}" BorderThickness="1" CornerRadius="4" Margin="0,0,8,0" Padding="8">
      <StackPanel ToolTip="{DynamicResource Loc_s155}">
       <TextBlock Text="{DynamicResource Loc_s249}" Style="{StaticResource Muted}" FontSize="11"/>
       <TextBlock x:Name="Aircraft" Text="—" FontSize="23" FontFamily="Segoe UI" FontWeight="Light" Foreground="{DynamicResource Brush32842C}" Margin="0,2,0,0"/>
      </StackPanel>
     </Border>
     <Border Background="{DynamicResource PanelSurface}" BorderBrush="{DynamicResource BrushB4CCDC}" BorderThickness="1" CornerRadius="4" Margin="0,0,8,0" Padding="8">
      <StackPanel><TextBlock Text="{DynamicResource Loc_s123}" Style="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="Rate" Text="—" FontSize="23" FontFamily="Segoe UI" FontWeight="Light" Margin="0,2,0,0"/></StackPanel>
     </Border>
     <Border Background="{DynamicResource PanelSurface}" BorderBrush="{DynamicResource BrushB4CCDC}" BorderThickness="1" CornerRadius="4" Margin="0,0,8,0" Padding="8">
      <StackPanel><TextBlock Text="{DynamicResource Loc_s167}" Style="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="Total" Text="0" FontSize="23" FontFamily="Segoe UI" FontWeight="Light" Margin="0,2,0,0"/></StackPanel>
     </Border>
     <Border Background="{DynamicResource PanelSurface}" BorderBrush="{DynamicResource BrushB4CCDC}" BorderThickness="1" CornerRadius="4" Padding="8">
      <StackPanel><TextBlock Text="{DynamicResource Loc_s045}" Style="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="VrsCount" Text="{DynamicResource Loc_s164}" FontSize="20" FontWeight="Normal" Margin="0,4,0,0"/></StackPanel>
     </Border>
    </UniformGrid>
    <Grid Grid.Row="2" Margin="0,0,0,10">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Background="{DynamicResource PanelSurface}" BorderBrush="{DynamicResource BrushB4CCDC}" BorderThickness="1" CornerRadius="4" Padding="10">
      <StackPanel ToolTip="{DynamicResource Loc_s154}">
       <DockPanel><TextBlock Text="{DynamicResource Loc_s113}" Foreground="{DynamicResource Brush47677C}"/><TextBlock x:Name="Mean" Text="{DynamicResource Loc_s151}" HorizontalAlignment="Right" Foreground="{DynamicResource Brush32842C}" FontSize="17" FontWeight="Normal" MinWidth="68"/></DockPanel>
       <ProgressBar x:Name="MeanBar" Minimum="0" Maximum="100" Height="19" Margin="0,10,0,5"/>
       <Grid TextBlock.Foreground="{DynamicResource Brush526F83}" TextBlock.FontSize="10">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <TextBlock Text="0"/><TextBlock Grid.Column="1" Text="25" HorizontalAlignment="Center"/><TextBlock Grid.Column="2" Text="50" HorizontalAlignment="Center"/><TextBlock Grid.Column="3" Text="75" HorizontalAlignment="Center"/><TextBlock Grid.Column="4" Text="100 %" HorizontalAlignment="Right"/>
