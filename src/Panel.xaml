<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Airspy ADS-B 控制台 · 2.0" Width="1180" Height="820"
 Background="#101927" Foreground="#E9F1FA" FontFamily="Microsoft YaHei UI"
 FontSize="12" WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
 SnapsToDevicePixels="True">
 <Window.Resources>
  <SolidColorBrush x:Key="Accent" Color="#5DDEB5"/>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style x:Key="Muted" TargetType="TextBlock"><Setter Property="Foreground" Value="#A4B6CA"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#E9F1FA"/><Setter Property="Background" Value="#2B3D53"/>
   <Setter Property="Padding" Value="12,9"/><Setter Property="Margin" Value="0,3"/>
   <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Body" CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Opacity" Value="0.84"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Body" Property="Opacity" Value="0.45"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#101927"/><Setter Property="Foreground" Value="#E9F1FA"/><Setter Property="BorderBrush" Value="#3A5069"/><Setter Property="Padding" Value="8,6"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="MinHeight" Value="32"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#142236"/><Setter Property="Background" Value="#DCE6EF"/><Setter Property="Padding" Value="8,5"/><Setter Property="MinHeight" Value="32"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#D7E5F2"/><Setter Property="Margin" Value="0,10"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="TabItem"><Setter Property="Foreground" Value="#142236"/><Setter Property="Padding" Value="16,8"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#24364C"/><Setter Property="Foreground" Value="#BDCEE0"/><Setter Property="Padding" Value="9,10"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontWeight" Value="Normal"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="8,7"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="DataGridRow"><Setter Property="Foreground" Value="#E9F1FA"/><Setter Property="Background" Value="#172536"/><Setter Property="MinHeight" Value="36"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#34546D"/></Trigger></Style.Triggers></Style>
 </Window.Resources>
 <Grid Margin="20,12,20,12" Background="#101927">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,14">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel>
    <TextBlock Text="AIRSPY / ADS-B" FontSize="23" FontWeight="Bold"/>
    <TextBlock Text="1090 MHz 接收工作台 · 实时遥测与 VRS 联动" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
   </StackPanel>
   <Border Grid.Column="1" Background="#20384A" CornerRadius="6" Padding="16,9" VerticalAlignment="Center" Margin="12,0,0,0">
    <TextBlock x:Name="RunState" Text="待启动" Foreground="#5DDEB5" FontWeight="Bold"/>
   </Border>
  </Grid>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="270"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="#1A293B" CornerRadius="10">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16">
     <StackPanel>
      <TextBlock Text="接收设置" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
      <Grid x:Name="InputGrid">
       <Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <TextBlock Text="数据端口" Style="{StaticResource Muted}"/><TextBox x:Name="Port" Grid.Column="1" Margin="0,0,0,8"/>
       <TextBlock Grid.Row="1" Text="输出格式" Style="{StaticResource Muted}"/><TextBlock Grid.Row="1" Grid.Column="1" Text="Beast · 含信号电平" Margin="0,5,0,12"/>
       <TextBlock Grid.Row="2" Text="射频增益" Style="{StaticResource Muted}"/><ComboBox x:Name="Gain" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8"/>
       <TextBlock Grid.Row="3" Text="MLAT / MHz" Style="{StaticResource Muted}"/><ComboBox x:Name="Sample" Grid.Row="3" Grid.Column="1" Margin="0,0,0,8" ToolTip="自动：不传 -m 参数。24 MHz 仅适用于支持该模式的 R2。此项不是接收频率。"/>
       <TextBlock Grid.Row="4" Text="过滤强度" Style="{StaticResource Muted}"/><TextBox x:Name="Filter" Grid.Row="4" Grid.Column="1" Margin="0,0,0,4" ToolTip="1–60，默认 4；越高通常需要更多 CPU。"/>
       <CheckBox x:Name="Packing" Grid.Row="5" Grid.ColumnSpan="2" Content="启用位打包 (-p)"/>
      </Grid>
      <Grid Margin="0,2,0,0">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Button x:Name="Start" Content="开始接收" Background="#5DDEB5" Foreground="#102B2D"/>
       <Button x:Name="Stop" Grid.Column="2" Content="停止" IsEnabled="False"/>
      </Grid>
      <Button x:Name="Save" Content="保存配置"/>
      <TextBlock Text="默认参数适合先连通设备。修改参数前请先停止接收。" Style="{StaticResource Muted}" FontSize="11" Margin="0,8,0,14"/>
      <Border Height="1" Background="#34465A" Margin="0,0,0,14"/>
      <TextBlock Text="VRS 飞机地图" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
      <Button x:Name="LinkVrs" Content="一键联动 VRS" ToolTip="备份配置，设置本机 Beast 接收机并启动 VRS；若已运行，会先正常关闭再启动。"/>
      <Button x:Name="Map" Content="打开飞机地图 ↗"/>
      <Button x:Name="Diagnose" Content="检查连接"/>
      <TextBlock x:Name="VrsHint" Text="等待检查 VRS。" Style="{StaticResource Muted}" FontSize="11" Margin="0,8,0,12"/>
      <Expander Header="程序路径与地图地址" Foreground="#E9F1FA" Padding="0,4">
       <StackPanel Margin="0,9,0,0">
        <TextBlock Text="解码器 exe" Style="{StaticResource Muted}"/>
        <TextBox x:Name="DecoderPath" Margin="0,5,0,4"/><Button x:Name="BrowseDecoder" Content="选择解码器"/>
        <TextBlock Text="VRS exe" Style="{StaticResource Muted}" Margin="0,8,0,0"/>
        <TextBox x:Name="VrsPath" Margin="0,5,0,4"/><Button x:Name="BrowseVrs" Content="选择 VRS"/>
        <TextBlock Text="地图地址" Style="{StaticResource Muted}" Margin="0,8,0,0"/><TextBox x:Name="MapUrl" Margin="0,5,0,4"/>
        <Button x:Name="SavePaths" Content="保存路径与地址"/>
       </StackPanel>
      </Expander>
     </StackPanel>
    </ScrollViewer>
   </Border>
   <Grid Grid.Column="2">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <UniformGrid Columns="4" Margin="0,0,0,12">
     <Border Background="#1A293B" CornerRadius="8" Margin="0,0,8,0" Padding="12">
      <StackPanel ToolTip="最近 60 秒有 DF11 或 DF17 显式 ICAO 报文的去重飞机数。与 VRS 的超时和统计范围可能不同。">
       <TextBlock Text="飞机 · 60 秒内" Style="{StaticResource Muted}" FontSize="11"/>
       <TextBlock x:Name="Aircraft" Text="—" FontSize="27" FontWeight="SemiBold" Foreground="#5DDEB5" Margin="0,5,0,0"/>
      </StackPanel>
     </Border>
     <Border Background="#1A293B" CornerRadius="8" Margin="0,0,8,0" Padding="12">
      <StackPanel><TextBlock Text="报文 / 秒" Style="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="Rate" Text="—" FontSize="27" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
     </Border>
     <Border Background="#1A293B" CornerRadius="8" Margin="0,0,8,0" Padding="12">
      <StackPanel><TextBlock Text="本次报文总数" Style="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="Total" Text="0" FontSize="27" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
     </Border>
     <Border Background="#1A293B" CornerRadius="8" Padding="12">
      <StackPanel><TextBlock Text="VRS 飞机" Style="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="VrsCount" Text="未连接" FontSize="22" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel>
     </Border>
    </UniformGrid>
    <Grid Grid.Row="1" Margin="0,0,0,12">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Background="#1A293B" CornerRadius="8" Padding="14">
      <StackPanel ToolTip="最近 3 秒收到的 Beast 报文电平算术平均，0–255 映射到 0–100%；不是校准的 dBm，也不是噪声底。">
       <DockPanel><TextBlock Text="平均信号强度" Foreground="#BDCEE0"/><TextBlock x:Name="Mean" Text="暂无数据" HorizontalAlignment="Right" Foreground="#5DDEB5" FontSize="19" FontWeight="SemiBold"/></DockPanel>
       <ProgressBar x:Name="MeanBar" Minimum="0" Maximum="100" Height="10" BorderThickness="0" Background="#30445A" Foreground="#5DDEB5" Margin="0,12,0,8"/>
       <TextBlock Text="近 3 秒 · Beast 相对电平 %" Style="{StaticResource Muted}" FontSize="10"/>
      </StackPanel>
     </Border>
     <Border Grid.Column="2" Background="#1A293B" CornerRadius="8" Padding="14">
      <StackPanel ToolTip="最近 3 秒收到的 Beast 报文中最高相对电平；无报文时清空。">
       <DockPanel><TextBlock Text="峰值信号强度" Foreground="#BDCEE0"/><TextBlock x:Name="Peak" Text="暂无数据" HorizontalAlignment="Right" Foreground="#F6C474" FontSize="19" FontWeight="SemiBold"/></DockPanel>
       <ProgressBar x:Name="PeakBar" Minimum="0" Maximum="100" Height="10" BorderThickness="0" Background="#30445A" Foreground="#F6C474" Margin="0,12,0,8"/>
       <TextBlock Text="近 3 秒 · Beast 相对电平 %" Style="{StaticResource Muted}" FontSize="10"/>
      </StackPanel>
     </Border>
    </Grid>
    <Border Grid.Row="2" Background="#1A293B" CornerRadius="8" Padding="12">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock x:Name="DataState" Text="等待接收数据" Style="{StaticResource Muted}" Margin="2,0,0,10"/>
      <TabControl Grid.Row="1" Background="#101927" BorderThickness="0" Foreground="#E9F1FA">
       <TabItem Header="飞机列表">
        <Grid>
         <DataGrid x:Name="Planes" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
          HeadersVisibility="Column" GridLinesVisibility="None" Background="#101927" BorderThickness="0" RowHeaderWidth="0" SelectionMode="Single"
          ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
          <DataGrid.Columns>
           <DataGridTextColumn Header="ICAO" Binding="{Binding Icao}" Width="80"/>
           <DataGridTextColumn Header="呼号" Binding="{Binding Callsign}" Width="*" MinWidth="96"/>
           <DataGridTextColumn Header="高度" Binding="{Binding Altitude}" Width="95"/>
           <DataGridTextColumn Header="电平" Binding="{Binding Signal}" Width="75"/>
           <DataGridTextColumn Header="报文" Binding="{Binding Messages}" Width="65"/>
           <DataGridTextColumn Header="距上次" Binding="{Binding LastSeen}" Width="75"/>
          </DataGrid.Columns>
         </DataGrid>
         <TextBlock x:Name="Empty" Text="暂无飞机&#10;接入接收机并点击“开始接收”" TextAlignment="Center" Foreground="#91A7BD" FontSize="15" VerticalAlignment="Center" IsHitTestVisible="False"/>
        </Grid>
       </TabItem>
       <TabItem Header="运行日志">
        <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <TextBox x:Name="Log" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" FontFamily="Consolas" FontSize="12"/>
         <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="4">
          <Button x:Name="ClearLog" Content="清空显示" Margin="0,0,8,0"/><Button x:Name="ExportLog" Content="导出日志"/>
         </StackPanel>
        </Grid>
       </TabItem>
       <TabItem Header="联动诊断">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="14">
         <TextBlock Text="解码器 → Beast 数据 → VRS → 浏览器地图" FontSize="14" FontWeight="SemiBold"/>
         <TextBlock x:Name="Diagnostics" Margin="0,14,0,14" Foreground="#BDCEE0"/>
         <TextBlock Text="启动命令" Style="{StaticResource Muted}" Margin="0,12,0,4"/>
         <TextBox x:Name="Command" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"/>
         <TextBlock Text="信号表来自已解码报文的相对电平，不是频谱仪或噪声底测量。飞机按 DF11/17 的 ICAO 去重，60 秒未收到消息后移出列表。" Style="{StaticResource Muted}" FontSize="11" Margin="0,16,0,0"/>
        </StackPanel></ScrollViewer>
       </TabItem>
      </TabControl>
      <TextBlock Text="实时数据来自本机 Beast 数据流；无数据时不显示模拟读数。" Grid.Row="2" Style="{StaticResource Muted}" FontSize="10" Margin="2,8,0,0"/>
     </Grid>
    </Border>
   </Grid>
  </Grid>
  <TextBlock x:Name="Footer" Grid.Row="2" Text="就绪 · Airspy R0 / R2 / Mini" Style="{StaticResource Muted}" FontSize="11" Margin="2,12,0,0"/>
 </Grid>
</Window>
